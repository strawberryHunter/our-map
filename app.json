{
  "expo": {
    "name": "OURS",
    "slug": "our-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.strawberryhunter.ourmap",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.strawberryhunter.ourmap",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "@maplibre/maplibre-react-native",
      "react-native-fast-tflite",
      [
        "expo-media-library",
        {
          "photosPermission": "둘이 함께 나온 사진을 찾아 추억으로 정리하려고 사진에 접근해요.",
          "savePhotosPermission": "만든 추억 영화를 갤러리에 저장해요.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "추억으로 만들 사진과 얼굴 등록용 사진을 고를 때 사진에 접근해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-build-properties"
    ],
    "scheme": "ours",
    "experiments": {
      "typedRoutes": false
    }
  }
}